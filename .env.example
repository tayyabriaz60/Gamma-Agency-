# ===========================================
# The Gamma Agency — Environment Variables
# ===========================================

# --- EmailJS (contact form) — REQUIRED ---
# 1. Sign up at https://www.emailjs.com with gammaagency97@gmail.com
# 2. Add Email Service → Gmail → connect gammaagency97@gmail.com
# 3. Create template ID: gamma_agency_contact
#    Template variables: {{full_name}} {{email}} {{phone}} {{subject}} {{message}}
# 4. Copy Service ID, Template ID, and Public Key below
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=gamma_agency_contact
VITE_EMAILJS_PUBLIC_KEY=

# --- Meta Pixel (Facebook/Instagram ads) — OPTIONAL ---
# Create at https://business.facebook.com → Events Manager → New Pixel
VITE_META_PIXEL_ID=

# --- Calendly (Book Your Free Consultation) ---
VITE_CALENDLY_URL=
